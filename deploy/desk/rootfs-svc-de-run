#!/usr/bin/with-contenv bash
# desk session: labwc compositor + acme pair, all supervised from here.
mkdir -p /config/.XDG
chown -R abc:abc /config/.XDG

# compositor (its own backend; config via -C, autostart NOT used)
(
  export XDG_RUNTIME_DIR=/config/.XDG
  unset DISPLAY WAYLAND_DISPLAY
  exec s6-setuidgid abc labwc -C /config/.config/labwc/rc.xml
) &
LABWC=$!

# wait for the compositor socket (skip stale: pick the youngest wayland-N)
SOCK=""
for i in $(seq 1 40); do
  SOCK=$(ls -t /config/.XDG 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -1)
  [ -n "$SOCK" ] && break
  sleep 0.5
done
echo "desk: compositor socket = $SOCK"

# acme pair (as abc), relaunching if it dies
(
  export XDG_RUNTIME_DIR=/config/.XDG
  export WAYLAND_DISPLAY="$SOCK"
  unset DISPLAY
  while :; do
    s6-setuidgid abc /usr/local/bin/launch-desk-acme.sh
    sleep 8
  done
) &

wait $LABWC
