[Unit]
Description=desk — lean labwc desktop (acme + terminal + browser)
After=network-online.target

[Container]
Image=localhost/desk:v1
ContainerName=desk
PublishPort=3007:3000
PublishPort=3008:3001
Environment=CUSTOM_USER=e4779
EnvironmentFile=/srv/homelab/desk/desk.secret.env
Environment=TITLE=desk
Environment=SELKIES_ENCODER=x264enc,jpeg
Environment=PIXELFLUX_WAYLAND=true
Volume=/srv/homelab/desk/config:/config
Volume=/srv/homelab/acme-web/plan9port:/config/plan9port
Volume=/srv/homelab/desk/bin/p9draw-server:/usr/local/bin/p9draw-server:ro
Volume=/srv/homelab/desk/svc-de-run:/etc/s6-overlay/s6-rc.d/svc-de/run:ro
Volume=/srv/homelab/desk/launch-desk-acme.sh:/usr/local/bin/launch-desk-acme.sh:ro
Volume=/srv/homelab/desk/desk-acme-keepalive.sh:/usr/local/bin/desk-acme-keepalive.sh:ro
Volume=/srv/homelab/desk/custom-cont-init.d:/custom-cont-init.d
Volume=/home/e4779/.bun:/home/abc/.bun
Volume=/home/e4779/.pi:/home/abc/.pi

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
