#!/usr/bin/with-contenv bash
# gershwin-desk session: Gershwin (Workspace + Menu + WindowManager) on the X
# display. X path, NOT the PIXELFLUX_WAYLAND scene used by the old labwc desk:
# gershwin-session/uROSWM are X11 (uROSWM is XCB). Selkies captures the X
# display — the base image default architecture (as in webtop-gershwin, 2026-09).
pkill -x gershwin-session 2>/dev/null
sleep 1

# gershwin-session spawns its components (Workspace, Menu, WindowManager) by
# bare name; they live in the GNUstep system domain — put them on PATH.
export PATH="/System/Library/Tools:$PATH"

# UI scale: Selkies HiDPI mode streams device pixels, so Gershwin must render
# at 2x. NSScreen userSpaceScaleFactor reads the GSScaleFactor user default
# first (fallback dpi/144 gives 0.667 at 96dpi — hence the tiny UI). Persisted
# in /config via abc's GNUstep defaults; restart components to apply.
HOME=/config s6-setuidgid abc /System/Library/Tools/defaults write NSGlobalDomain GSScaleFactor 2.0 2>/dev/null || true

# X display: quadlet sets DISPLAY=:1 and Xvfb is started by the base image.
# No ls-parsing here: plan9port utils must never leak into this script, and
# global PATH stays GNU (see Containerfile).
DISPLAY="${DISPLAY:-:1}"
if [ ! -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
  echo "gershwin-desk: WARNING: socket for DISPLAY=$DISPLAY missing, forcing :1"
  DISPLAY=":1"
fi
export DISPLAY
echo "gershwin-desk: session on DISPLAY=$DISPLAY"

exec s6-setuidgid abc /usr/local/bin/gershwin-session Workspace Menu WindowManager
